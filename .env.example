# 腾讯云 COS 部署配置（复制本文件为 .env 并填写真实值）
# .env 已被 .gitignore 忽略，密钥不会提交到仓库。
# 访问管理 → 访问密钥（API 密钥管理）获取 SecretId / SecretKey：
#   https://console.cloud.tencent.com/cam/capi

# 永久密钥（建议为部署单独创建一个仅有该桶权限的子账号密钥）
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey

# 存储桶名称，格式为 名称-APPID，例如 meow-catch-1250000000
COS_BUCKET=meow-catch-1250000000

# 存储桶所在地域，例如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION=ap-guangzhou
